# ─── Supabase (production) ───────────────────────────────────────────────────
# Leave blank to use the local SQLite database in data/ (development mode).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Groq LLM (AI studies) ───────────────────────────────────────────────────
# Get your key at https://console.groq.com/keys
# Available models: llama-3.3-70b-versatile | llama-3.1-8b-instant | mixtral-8x7b-32768
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Analysis endpoint security ──────────────────────────────────────────────
# POST /api/v1/studies is called by a public frontend button, so it is protected
# by per-IP rate limiting only (no secret key — a public button can't hold one
# without exposing it to every visitor).

# Rate limit: max AI study requests per IP per hour (default: 5)
ANALYSIS_RATE_LIMIT_PER_HOUR=5

# ─── Collection endpoints security ───────────────────────────────────────────
# Visitors never trigger a collection: the public site has no such button. Every
# POST /api/v1/collection/* route needs this secret in the X-Collection-Key header. It is
# used by the daily GitHub workflow (secret COLLECTION_API_KEY) and by administrators'
# scripts; the admin area has its own sign-in. Without it the routes answer 503.
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
COLLECTION_API_KEY=

# Max collection requests per IP per hour (even with the key; default: 10)
COLLECTION_RATE_LIMIT_PER_HOUR=10

# ─── Public read limits (per IP and minute) ──────────────────────────────────
# Reading needs no key, but one client must not drain the free-tier bandwidth.
READ_RATE_LIMIT_PER_MINUTE=120
EXPORT_RATE_LIMIT_PER_MINUTE=10

# ─── Storage ─────────────────────────────────────────────────────────────────
DATABASE_PATH=data/freedatatd.db

# ─── Reverse proxy (Render, etc.) ─────────────────────────────────────────────
# Set FORWARDED_ALLOW_IPS=* in the hosting dashboard (not here): otherwise every visitor
# appears to come from the proxy's IP and the per-IP rate limits become one shared limit.
# See docs/deployment.md

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── NASA FIRMS (fire data) ──────────────────────────────────────────────────
# Get your free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key
# Required for EnvironmentAgent bush fire monitoring
NASA_FIRMS_KEY=
