# ─── Supabase (production) ───────────────────────────────────────────────────
# Leave blank to use the local SQLite database in data/ (development mode).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Groq LLM (AI studies) ───────────────────────────────────────────────────
# Get your key at https://console.groq.com/keys
# Available models: llama-3.3-70b-versatile | llama-3.1-8b-instant | mixtral-8x7b-32768
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Analysis endpoint security ──────────────────────────────────────────────
# POST /api/v1/studies is called by a public frontend button, so it is protected
# by per-IP rate limiting only (no secret key — a public button can't hold one
# without exposing it to every visitor).

# Rate limit: max AI study requests per IP per hour (default: 5)
ANALYSIS_RATE_LIMIT_PER_HOUR=5

# ─── Collection endpoints security ───────────────────────────────────────────
# Split by exposure:
# - Public (called by the "COLLECT LIVE DATA" button in the UI): agriculture,
#   environment, markets, economy — protected by per-IP rate limiting only,
#   same reasoning as the analysis endpoint (a public button can't hold a
#   secret without exposing it to every visitor).
# - Admin-only (never called by any UI button): transport, education, and
#   run-scheduled-harvest — still require this secret key, since there's no
#   public-button conflict for them.
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
COLLECTION_API_KEY=

# Rate limit: max collection triggers per IP per hour, applies to both the
# public (rate-limit-only) and admin (key + rate-limit) endpoints (default: 10)
COLLECTION_RATE_LIMIT_PER_HOUR=10

# ─── Storage ─────────────────────────────────────────────────────────────────
DATABASE_PATH=data/freedatatd.db

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── NASA FIRMS (fire data) ──────────────────────────────────────────────────
# Get your free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key
# Required for EnvironmentAgent bush fire monitoring
NASA_FIRMS_KEY=
